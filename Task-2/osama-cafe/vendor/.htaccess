# Blocks all direct web access to Composer's dependency folder — nothing in
# here is meant to be requested directly by a browser. PHP's own require/
# autoload calls read these by filesystem path and are unaffected.
# Apache only (XAMPP); PHP's built-in server (`php -S`) ignores .htaccess.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
